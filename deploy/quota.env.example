# Settings for agent/quota_collector.py. Copy to deploy/quota.env (gitignored: it holds
# the agent token) and run it from cron on a login node of the site, e.g. every 10 min:
#
#   */10 * * * * /usr/bin/python3 $HOME/gpu-monitoring/agent/quota_collector.py --env $HOME/gpu-monitoring/deploy/quota.env >> $HOME/gpu-monitoring/.run/quota.log 2>&1
#
# Check it first with --dry-run, which prints the report instead of posting it.

GPU_QUOTA_HUB_URL=https://<tunnel>.trycloudflare.com
GPU_QUOTA_TOKEN=<agent token, from the hub's .state/agent_token>
# One collector per contract. CLUSTER is the key (unique per contract, also what the
# dashboard's CARD_ORDER names); LABEL is what the card shows.
GPU_QUOTA_CLUSTER=hangang-arpa
GPU_QUOTA_LABEL=hangang (ARPA)
# What one ISAM second is: a whole node ("node") or a single GPU ("gpu").
GPU_QUOTA_UNIT=node
GPU_QUOTA_GPUS_PER_NODE=4
# Everyone on the account. ISAM leaves out users with no usage; these are shown at 0.
GPU_QUOTA_MEMBERS=t651a01,t651a02
GPU_QUOTA_ISAM=isam
